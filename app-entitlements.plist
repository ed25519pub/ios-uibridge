<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the whole point of the app: read other processes' accessibility trees -->
	<key>com.apple.private.accessibility</key>
	<true/>
	<key>com.apple.accessibility.api</key>
	<true/>
	<key>com.apple.accessibility.voiceover.axserver</key>
	<true/>

	<!-- stay resident: audio background mode + no container -->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<false/>
	<key>get-task-allow</key>
	<true/>
	<key>run-unsigned-code</key>
	<true/>

	<!-- HID injection, in case the app ends up being the one that dispatches events -->
	<key>com.apple.private.hid.client.event-dispatch</key>
	<true/>
	<key>com.apple.private.hid.client.event-monitor</key>
	<true/>
	<key>com.apple.private.iokit.ioallowall</key>
	<true/>
	<key>com.apple.private.springboard.services</key>
	<true/>
	<key>com.apple.springboard.services</key>
	<true/>

	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.iphone.axserver</string>
		<string>com.apple.accessibility.axserver</string>
		<string>com.apple.accessibility.axAuditDaemon</string>
		<string>com.apple.springboard.services</string>
		<string>com.apple.backboardd</string>
		<string>com.apple.frontboard.systemappservices</string>
	</array>
</dict>
</plist>
